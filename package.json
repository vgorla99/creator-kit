{
  "name": "creator-kit",
  "version": "2.0.0",
  "private": true,
  "description": "Creator Kit: one brand file in, motion-graphics reels (and soon websites) out",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "reels/studio-remotion"
  ],
  "scripts": {
    "doctor": "node setup/doctor.mjs",
    "brand:check": "node scripts/brand-check.mjs",
    "start": "npm run start -w reels/studio-remotion",
    "starter": "npm run reel -w reels/studio-remotion -- Starter",
    "new": "npm run new -w reels/studio-remotion --",
    "reel": "npm run reel -w reels/studio-remotion --",
    "produce": "npm run produce -w reels/studio-remotion --",
    "doc": "npm run doc -w reels/studio-remotion --",
    "pexels": "npm run pexels -w reels/studio-remotion --",
    "broll": "npm run broll -w reels/studio-remotion --",
    "library": "npm run library -w reels/studio-remotion --",
    "vo": "npm run vo -w reels/studio-remotion --",
    "publora": "npm run publora -w reels/studio-remotion --",
    "fonts": "npm run fonts -w reels/studio-remotion",
    "typecheck": "npm run typecheck -w reels/studio-remotion",
    "check:captions": "npm run check:captions -w reels/studio-remotion",
    "check:stock": "npm run check:stock -w reels/studio-remotion",
    "smoke": "npm run smoke -w reels/studio-remotion",
    "dashboard": "node scripts/run-in.mjs reels/dashboard start",
    "hf:preview": "node scripts/run-in.mjs reels/studio-hyperframes preview",
    "hf:render": "node scripts/run-in.mjs reels/studio-hyperframes render",
    "hf:check": "node scripts/run-in.mjs reels/studio-hyperframes check",
    "hf:snapshot": "node scripts/run-in.mjs reels/studio-hyperframes snapshot",
    "hf:smoke": "node scripts/run-in.mjs reels/studio-hyperframes smoke"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  }
}
