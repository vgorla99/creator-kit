node_modules/
out/
dist/
backups/
.DS_Store
Thumbs.db
*.log
*.secrets
.env
.env.*
!.env.example

# Local-only media. Do not commit audio/video you don't hold a redistribution
# license for — see reels/sounds/SOUND-LIBRARY.md.
reels/studio-remotion/public/audio/*
!reels/studio-remotion/public/audio/.gitkeep

# Footage engine: local media only (records live in reels/studio-remotion/assets/manifest.json).
reels/studio-remotion/public/footage/
reels/studio-remotion/public/library/

# Sound packs: downloaded by each creator, never redistributed.
reels/sounds/*/

# Your videos, voice-overs and images stay on your computer.
reels/content/**/*.mp4
reels/content/**/*.mov
reels/content/**/*.webm
reels/content/**/*.mp3
reels/content/**/*.wav
reels/content/**/*.m4a
reels/content/**/*.png
reels/content/**/*.jpg
reels/content/**/*.jpeg
reels/content/**/*.webp

# NOTE: reels/studio-remotion/src/kit/fonts.generated.ts is intentionally tracked.
# Regenerating it needs the @fontsource packages installed, which render-only
# environments may not have.

# Sites: research notes and Search Console exports stay local.
sites/research/*
!sites/research/README.md

# Setup: third-party skills are installed from their own repos (setup/skills.lock.yaml),
# never committed. Only Creator Kit's own skills are tracked.
.claude/skills/*
!.claude/skills/brand-intake/
!.claude/skills/niche-research/
!.claude/skills/site-builder/
!.claude/skills/motion-brief/
!.claude/skills/motion-vocabulary/
!.claude/skills/reel-pipeline/
!.claude/skills/post-video/
!.claude/skills/content-calendar-from-analytics/
.claude/settings.local.json
.claude/worktrees/
setup/.cache/
setup/logs/
setup/.choices.json
